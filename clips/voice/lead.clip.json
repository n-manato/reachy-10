      { "beat": 0.20, "pose": { "z": 2,   "pitch": -4, "x": -1 }, "interp": "minjerk" },
      { "beat": 0.35, "pose": { "z": 5,   "pitch": -7, "x": 1 },  "interp": "minjerk" },
      { "beat": 1.10, "pose": { "z": 4,   "pitch": -6, "x": 1 },  "interp": "minjerk" },
      { "beat": 1.70, "pose": { "z": 1,   "pitch": -2, "x": 0 },  "interp": "minjerk" },
      { "beat": 2.00, "pose": { "z": 0,   "pitch": 0,  "x": 0 },  "interp": "minjerk" }
    ],
    "body_yaw": [
