{
  "name": "woodblock_tap",
  "version": 1,
  "instrument": "woodblock",
  "description": "Short wood-block tap for fast passages. Same mechanics as woodblock_strike but compressed into 0.45 beats so consecutive eighth notes do not overlap.\n\nOverlap matters because clip contributions are ADDITIVE: two strike clips overlapping would sum their depths and drive the beater deeper than either intended -- straight into the stall condition. If you retrigger faster than a clip's own length, use this one.",
  "units": { "translation": "mm", "rotation": "deg" },
  "placement": "trigger",
  "anchors": [0.16],
  "loop_beats": 0.5,
  "tracks": {
    "head": [
      { "beat": 0.0,  "pose": { "z": 1.5,  "pitch": -4 }, "interp": "linear"  },
      { "beat": 0.16, "pose": { "z": -6,   "pitch": 8 },  "interp": "linear"  },
      { "beat": 0.25, "pose": { "z": -1,   "pitch": 2 },  "interp": "minjerk" },
      { "beat": 0.45, "pose": { "z": 0,    "pitch": 0 },  "interp": "minjerk" }
    ],
    "antennas": [
      { "beat": 0.0,  "value": 13, "interp": "minjerk" },
      { "beat": 0.16, "value": 21, "interp": "minjerk" },
      { "beat": 0.45, "value": 13, "interp": "minjerk" }
    ]
  }
}
