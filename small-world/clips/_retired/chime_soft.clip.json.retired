{
  "name": "chime_soft",
  "version": 1,
  "instrument": "chime_bar",
  "description": "Quiet chime strike for unaccented notes. Same shape as chime_strike at roughly two-thirds the depth, so a melody has dynamic shading instead of every note landing at the same volume. Bind it as the part's `clip` and use chime/strike as `accent_clip` -- the builder picks the accent automatically for notes with MIDI velocity >= 100.",
  "units": { "translation": "mm", "rotation": "deg" },
  "placement": "trigger",
  "anchors": [0.28],
  "loop_beats": 1.0,
  "tracks": {
    "head": [
      { "beat": 0.0,  "pose": { "z": 0,    "pitch": -2 }, "interp": "minjerk" },
      { "beat": 0.15, "pose": { "z": 2,    "pitch": -4 }, "interp": "linear"  },
      { "beat": 0.28, "pose": { "z": -4,   "pitch": 5 },  "interp": "linear"  },
      { "beat": 0.37, "pose": { "z": -0.5, "pitch": 1 },  "interp": "minjerk" },
      { "beat": 0.75, "pose": { "z": 0,    "pitch": 0 },  "interp": "minjerk" }
    ],
    "antennas": [
      { "beat": 0.0,  "value": 11, "interp": "minjerk" },
      { "beat": 0.28, "value": 18, "interp": "minjerk" },
      { "beat": 0.75, "value": 11, "interp": "minjerk" }
    ]
  }
}
