{
  "name": "chime_strike",
  "version": 1,
  "instrument": "chime_bar",
  "description": "Struck chime bar / glockenspiel bar -- one pitch per robot.\n\nThis is the instrument that turns a percussion demo into an orchestra: eight performers carrying eight pitches can play an actual melody acoustically, rather than only a rhythm.\n\nA chime bar rings freely and needs far less energy than a wood block, so the strike is deliberately shallower and softer than woodblock_strike. It also MUST leave the bar immediately -- a beater resting on a bar damps the note dead, which is both musically wrong and the exact sustained-contact condition that stalls a servo. The retract at beat 0.36 is doing double duty.\n\nThe slight forward lean (x) before contact reads as a player committing to the note; it is expressive, but it is inside the primary clip rather than in a secondary layer because it must never be muted near the anchor.",
  "units": { "translation": "mm", "rotation": "deg" },
  "placement": "trigger",
  "anchors": [0.28],
  "loop_beats": 1.0,
  "tracks": {
    "head": [
      { "beat": 0.0,  "pose": { "z": 0,   "pitch": -4, "x": 0 },   "interp": "minjerk" },
      { "beat": 0.13, "pose": { "z": 3.5, "pitch": -6, "x": 1.5 }, "interp": "linear"  },
      { "beat": 0.28, "pose": { "z": -6,  "pitch": 8,  "x": 2.5 }, "interp": "linear"  },
      { "beat": 0.36, "pose": { "z": -0.5, "pitch": 2, "x": 1.5 }, "interp": "minjerk" },
      { "beat": 0.75, "pose": { "z": 0,   "pitch": 0,  "x": 0 },   "interp": "minjerk" }
    ],
    "antennas": [
      { "beat": 0.0,  "value": 12, "interp": "minjerk" },
      { "beat": 0.28, "value": 24, "interp": "minjerk" },
      { "beat": 0.75, "value": 12, "interp": "minjerk" }
    ]
  }
}
