{
  "name": "bells_jingle",
  "version": 1,
  "instrument": "bells",
  "description": "Jingle bells on the antennas. The antennas are the fastest, lowest-inertia axis on the robot and can flick far quicker than the head, which suits a jingle. BUT they are xc330-class at +/-0.8 N.m -- roughly a quarter of the sts3215 Stewart servos. Keep the mounted bells to a few grams. Overloading an antenna is the single easiest way to burn out a motor on this machine, and the validator's antenna_velocity check is deliberately stricter than the head's for that reason.",
  "units": { "translation": "mm", "rotation": "deg" },
  "placement": "pattern",
  "loop_beats": 1.0,
  "anchors": [0.0, 0.5],
  "tracks": {
    "antennas": [
      { "beat": 0.0,  "value": 10, "interp": "minjerk" },
      { "beat": 0.18, "value": 34, "interp": "minjerk" },
      { "beat": 0.38, "value": 14, "interp": "minjerk" },
      { "beat": 0.5,  "value": 11, "interp": "minjerk" },
      { "beat": 0.68, "value": 28, "interp": "minjerk" },
      { "beat": 0.86, "value": 14, "interp": "minjerk" },
      { "beat": 1.0,  "value": 10, "interp": "minjerk" }
    ],
    "head": [
      { "beat": 0.0,  "pose": { "roll": 0 },   "interp": "minjerk" },
      { "beat": 0.12, "pose": { "roll": 2.5 }, "interp": "minjerk" },
      { "beat": 0.5,  "pose": { "roll": 0 },   "interp": "minjerk" },
      { "beat": 0.62, "pose": { "roll": -2 },  "interp": "minjerk" },
      { "beat": 1.0,  "pose": { "roll": 0 },   "interp": "minjerk" }
    ]
  }
}
